__pycache__/
*.py[cod]
.venv/
venv/
.env
*.zip
results/*.png
results/*.csv
results/*.zip
!results/.gitkeep
.DS_Store
*.raw
*.out
# PDK models are large — vendor them locally, don't commit
pdk/
results/checkpoints/
results/*.zip

# --- trained policy -----------------------------------------------------------
# The headline experiments (generalization.py, compare.py) both start with
# PPO.load(...), so without the weights nothing in RESULTS.md can be reproduced by
# anyone who clones this repo. 159 KB — small enough to track. Must come after the
# results/*.zip rules above: the LAST matching pattern wins.
!results/seq_agent.zip
# Same rule, same reason: seq_clean40k.zip (164 KB) is the frozen baseline every
# headline number in docs/REPRODUCE.md comes from. Untracked, the tag below is a
# reproducibility claim nobody can check.
!results/seq_clean40k.zip

# training logs: ngspice writes thousands of "Note: Transient op" lines to stderr
results/train.log*
results/*.err

# Guard-layer raw artifact store: one directory per simulation. The 40k training
# run alone produced 44,280 of them, 5.0 GB. It is an on-disk audit trail, not history.
results/raw/

# The same store, when an experiment is given its own output directory instead of the
# shared one. delivered_eye_audit's 45-corner run writes 765 of these, 12 MB, beside the
# 57 JSON summaries that ARE the result. Same reasoning as above: the audit trail stays
# on disk, the measurement is committed.
results/*/raw/

# Surrogate corpora: 18 MB each, and regenerable in ~20 min from results/raw by
# `surrogate_audit --rebuild`. What has to be reproducible is the PARSER and its
# ground-truth check, both of which are tracked; the blob is a cache.
#   surrogate_corpus_REALPART_BUG.npz is kept ON DISK, deliberately untracked, as the
#   evidence artifact for the mislabelling described in docs/REPRODUCE.md section 19.
#   It is INVALID and is not part of any reproducibility path.
results/*.npz

# ngspice run logs (noise, not results)
results/*.log
