__pycache__/
*.py[cod]
.venv/
venv/
.env
*.zip
results/*.png
results/*.csv
results/*.zip
!results/.gitkeep
.DS_Store
*.raw
*.out
# PDK models are large — vendor them locally, don't commit
pdk/
results/checkpoints/
results/*.zip

# vercel
.vercel/

# --- trained policy -----------------------------------------------------------
# The headline experiments (generalization.py, compare.py) both start with
# PPO.load(...), so without the weights nothing in RESULTS.md can be reproduced by
# anyone who clones this repo. 159 KB — small enough to track. Must come after the
# results/*.zip rules above: the LAST matching pattern wins.
!results/seq_agent.zip

# training logs: ngspice writes thousands of "Note: Transient op" lines to stderr
results/train.log*
results/*.err

# Guard-layer raw artifact store: one directory per simulation. The 40k training
# run alone produced 44,280 of them, 5.0 GB. It is an on-disk audit trail, not history.
results/raw/
